import torch
import torch.nn as nn
import torchvision.models as models

class AnomalyDetectionCNN(nn.Module):
    def __init__(self, num_classes=2, pretrained=True):
        super(AnomalyDetectionCNN, self).__init__()
        # Using ResNet50 as base model with transfer learning
        self.base_model = models.resnet50(pretrained=pretrained)
        
        # Replace final fully connected layer for binary classification
        in_features = self.base_model.fc.in_features
        self.base_model.fc = nn.Sequential(
            nn.Linear(in_features, 512),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(512, 128),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(128, num_classes)
        )
        
        # Multi-scale feature extraction
        self.attention = nn.MultiheadAttention(embed_dim=128, num_heads=4)
        
    def forward(self, x):
        # Extract features at different scales
        features = []
        x_down = x
        
        # Forward pass through base model
        x = self.base_model.conv1(x)
        x = self.base_model.bn1(x)
        x = self.base_model.relu(x)
        x = self.base_model.maxpool(x)
        
        x = self.base_model.layer1(x)
        features.append(self._pool_features(x))
        
        x = self.base_model.layer2(x)
        features.append(self._pool_features(x))
        
        x = self.base_model.layer3(x)
        features.append(self._pool_features(x))
        
        x = self.base_model.layer4(x)
        features.append(self._pool_features(x))
        
        # Adaptive pooling and flattening
        x = self.base_model.avgpool(x)
        x = torch.flatten(x, 1)
        
        # Classification head
        logits = self.base_model.fc(x)
        
        return logits, features
    
    def _pool_features(self, x):
        # Global average pooling for feature maps
        return nn.functional.adaptive_avg_pool2d(x, (1, 1)).squeeze(-1).squeeze(-1)
